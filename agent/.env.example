# Agent service configuration. Copy to .env and fill in.
# Get a free key at https://aistudio.google.com/apikey (see doc/plan/setup-licence-and-keys.md)
GOOGLE_API_KEY=your-gemini-api-key-here

# Pydantic AI model string. Free-tier Gemini by default.
# Alternatives: anthropic:claude-haiku-4-5 (needs ANTHROPIC_API_KEY, paid)
AGENT_MODEL=google:gemini-3.5-flash

MCP_URL=http://127.0.0.1:8000/mcp

# Shared secret with Tomcat; generated by `make secrets` (do not commit)
AGENT_TOKEN=
